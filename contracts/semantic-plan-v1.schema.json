{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-compass.local/semantic-plan-v1.schema.json",
  "title": "External semantic plan v1 (semantics unverified)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "idea", "intent", "core", "required_conditions", "excluded_conditions", "unknowns", "clarification"],
  "properties": {
    "version": {"const": 1},
    "idea": {"type": "string", "minLength": 4, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"},
    "intent": {"enum": ["find_project", "develop", "learn", "unclear"]},
    "core": {"anyOf": [{"$ref": "#/$defs/core"}, {"type": "null"}]},
    "alternative": {"anyOf": [{"$ref": "#/$defs/core"}, {"type": "null"}]},
    "required_conditions": {"$ref": "#/$defs/texts"},
    "excluded_conditions": {"$ref": "#/$defs/texts"},
    "unknowns": {"$ref": "#/$defs/texts"},
    "clarification": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
  },
  "allOf": [{
    "if": {"properties": {"core": {"type": "null"}}, "required": ["core"]},
    "then": {"properties": {"clarification": {"$ref": "#/$defs/text"}, "alternative": {"type": "null"}}}
  }],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"},
    "texts": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "phrase": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[ -][A-Za-z0-9]+)*$"},
    "core": {"type": "object", "additionalProperties": false, "required": ["object", "action"], "properties": {"object": {"$ref": "#/$defs/phrase"}, "action": {"$ref": "#/$defs/phrase"}}}
  }
}
